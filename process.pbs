#PBS -S /bin/bash
#PBS -N process_piv
#PBS -q normal
#PBS -l select=1:ncpus=128:mpiprocs=128:model=mil_ait,walltime=02:00:00
#PBS -j oe
#PBS -M arozman@bu.edu
#PBS -m abe

source ~/python.sh

cd $PBS_O_WORKDIR

echo "Starting unsteady velocity and vortex extraction pipeline..."
python -u process_unsteady_and_vortices.py \
    --input "coviz/pivplane_*.fvuns" \
    --output_h5 "velocity_and_vortex_data.h5" \
    --dx 0.078125 \
    --dz 0.078125 \
    --theta -20.0 \
    --diameter 24.0 \
    --q_thresh 1.0e6 > process.out 2>&1

echo "Generating standalone comparison figures..."
python -u plot_comparisons.py \
    --h5 "velocity_and_vortex_data.h5" \
    --outdir "plots" >> process.out 2>&1

echo "Pipeline execution finished!"

